<launch>
  <arg name="world_file" default="$(find project1_turtlebot)/worlds/map.world"/>

  <!-- We can just reuse the already provided launch for putting the bot in gazebo -->
  <include file="$(find turtlebot_gazebo)/launch/turtlebot_world.launch">
    <arg name="world_file" value="$(arg world_file)"/>
  </include>

  <!-- Mapping -->
  <include file="$(find turtlebot_gazebo)/launch/gmapping_demo.launch"></include>

  <!-- Rvis -->
  <include file="$(find turtlebot_rviz_launchers)/launch/view_navigation.launch"></include>

  <!-- Teleop... Kind of makes the terminal ugly -->
  <include file="$(find turtlebot_teleop)/launch/keyboard_teleop.launch"></include>

  <!-- TODO: Our Architecture -->
  <node pkg="project1_turtlebot" type="project1_turtlebot" name="project1_turtlebot" output="screen"/>

  <!-- TODO: Launch the other things presumably? -->
</launch>
